{
  "name": "local-deals-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @local-deals/api",
    "dev:admin": "npm run dev -w @local-deals/admin",
    "dev:workspaces": "node scripts/local-workspaces.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "backup:status": "node scripts/postgres-backup-status.mjs",
    "backup:restore-drill": "node scripts/postgres-restore-drill.mjs",
    "backup:test": "node --test scripts/postgres-backup-format.test.mjs scripts/postgres-backup-status.test.mjs",
    "migration:test": "node --test scripts/migration-compatibility-verify.test.mjs",
    "migration:verify": "node scripts/migration-compatibility-verify.mjs",
    "openapi:generate": "npm run openapi:generate -w @local-deals/api",
    "openapi:types": "npm run openapi:generate && openapi-typescript packages/api-contract/openapi.json -o packages/api-contract/src/generated-openapi.d.ts",
    "openapi:verify": "node scripts/openapi-contract-verify.mjs",
    "compatibility:verify": "node scripts/release-compatibility-verify.mjs",
    "compatibility:test": "node --test scripts/release-compatibility-verify.test.mjs",
    "release:verify": "node scripts/release-verify.mjs --build-workspaces",
    "build": "npm run build -w @local-deals/api && npm run build -w @local-deals/admin",
    "test": "npm run test -w @local-deals/api && node --test scripts/miniprogram-regression.test.mjs scripts/workspace-build-invariants.test.mjs scripts/local-workspaces-order.test.mjs scripts/playwright-config.test.mjs scripts/docker-smoke-support.test.mjs",
    "architecture:verify": "node scripts/architecture-verify.mjs",
    "typecheck": "npm run lint -w @local-deals/api && npm run lint -w @local-deals/api-contract && npm run lint -w @local-deals/admin && npm run lint -w @local-deals/miniprogram-customer && npm run lint -w @local-deals/miniprogram-verifier",
    "lint:eslint": "eslint apps scripts --max-warnings 0",
    "lint": "npm run typecheck && npm run lint:eslint"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@redocly/openapi-core": "1.34.7"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0"
  }
}

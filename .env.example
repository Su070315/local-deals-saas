# 使用真实数据库时必须显式声明运行环境；本地 Docker 与开发数据库填写 development。
# 汇付延迟到账默认关闭；只有汇付侧完成延迟交易开通并通过灰度验证后才设为 true。
HUIFU_DELAYED_SETTLEMENT_ENABLED=false
# 所有共享/生产 Node 进程和 PostgreSQL 会话统一使用 UTC；界面和账期边界再转换为 Asia/Shanghai。
TZ=UTC
DATABASE_URL=postgres://localdeals:localdeals@localhost:5432/local_deals
# PostgreSQL 连接池与请求边界。总连接预算应满足：所有 API/工作器副本的 DB_POOL_MAX 之和，小于托管数据库可用连接数并预留运维连接。
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
# 仅本机 Docker/演示库允许。development 连接真实数据库时，未明确设为 true 会按共享环境失败关闭。
ALLOW_DEMO_MODE=true
# 仅限一次性部署任务；多实例应用启动时保持 false。
RUN_MIGRATIONS_ON_STARTUP=false
# 真实数据库部署时仅由一个工作实例显式设为 true；其余应用实例保持 false。
RUN_LIFECYCLE_WORKER=false
# 完整生命周期 sweep 处理导入、批量任务、账单和恢复；共享环境默认 60 秒，本地工作台可缩短以便演示。
LIFECYCLE_SWEEP_POLL_INTERVAL_SECONDS=60
# 仅供配置了 RUN_LIFECYCLE_WORKER=true 的独立工作实例监控；连续 3 个 60 秒 sweep 未成功会让 /api/public/health/worker 返回 503。
LIFECYCLE_WORKER_MAX_STALENESS_SECONDS=180
# 每轮生命周期 sweep 最多生成的导出任务数，限制 CSV/加密工作量，避免后台任务挤占退款、过期和账单处理。
EXPORT_WORKER_BATCH_SIZE=3
# 最早排队或处理中的导出超过此秒数时，/api/public/health/worker 返回 503，以便监控扩容或排障。
EXPORT_QUEUE_MAX_AGE_SECONDS=600
# 订单超时与券过期由 Worker 分批推进。最早积压超过此秒数时，/api/public/health/worker 返回 503。
EXPIRY_QUEUE_MAX_AGE_SECONDS=600
# 独立过期队列循环每批最多处理的待支付订单数和券数，限制支付查单、库存回补和审计写入压力。
EXPIRY_SWEEP_BATCH_SIZE=200
# 订单超时与券过期的独立轮询间隔；与完整生命周期任务共用数据库租约。
EXPIRY_SWEEP_POLL_INTERVAL_SECONDS=10
# 独立审计签名循环每隔此秒数领取一批事件；它与完整生命周期 sweep 共用数据库租约，避免多 Worker 破坏全局链顺序。
AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=5
# 每个独立审计签名循环最多签名的 outbox 数。业务事务只写 outbox，签名在 Worker 中顺序完成。
AUDIT_OUTBOX_BATCH_SIZE=100
# 审计 outbox 最早等待或处理中事件超过此秒数，或出现完整性隔离事件时，/api/public/health/worker 返回 503。
AUDIT_OUTBOX_MAX_AGE_SECONDS=300
# 平台安全审计进行全链完整性检查时每次读取的最大记录数。该检查仍为 O(n)，但不会一次性装载全部历史；生产应在低峰期运行并保留执行时长证据。
AUDIT_CHAIN_VERIFY_BATCH_SIZE=500
# 中国售后 SLA 运营日历。法定休假日与调休工作日均用逗号分隔的 YYYY-MM-DD；共享环境必须把有效期至少维护到未来 90 天。
CHINA_OPERATIONAL_HOLIDAYS=
CHINA_OPERATIONAL_WORKDAYS=
CHINA_OPERATIONAL_CALENDAR_VALID_THROUGH=
# 预发、生产及任何共享环境必须使用随机生成的 32 字节 Base64 密钥；本地开发可留空使用内置演示密钥。
DATA_ENCRYPTION_KEY=
# 活动数据密钥的稳定标识。轮换时换成新标识，并把旧密钥放入 DATA_ENCRYPTION_PREVIOUS_KEYS。
DATA_ENCRYPTION_KEY_ID=
# 退役但仍需读取的密钥，格式：keyId:base64Key,keyId:base64Key。完成重加密并核验后移除。
DATA_ENCRYPTION_PREVIOUS_KEYS=
# 预发、生产及任何共享环境必须配置独立随机的 32 字节 Base64 密钥，用于审计链 HMAC 签名。
AUDIT_LOG_SIGNING_KEY=
# 预发、生产及任何共享环境必须替换为至少 32 位的独立随机值；示例值会被 API 拒绝。
JWT_SECRET=replace-this-before-any-shared-deployment
VOUCHER_TOKEN_SECRET=replace-this-before-any-shared-deployment
# 限流身份哈希专用密钥；必须与 JWT_SECRET 和 VOUCHER_TOKEN_SECRET 独立，不能复用。
THROTTLE_KEY_SECRET=replace-this-before-any-shared-deployment
PORT=3001
# 非本地环境必须是本次可回滚发布的非敏感标识；会出现在健康响应、API 响应头和工作台清单中。
RELEASE_ID=
# 浏览器工作台的精确来源。本地可用旧的 CORS_ORIGIN；预发与生产必须显式使用 HTTPS 子域名。
CORS_ORIGINS=http://localhost:5173
# 共享环境必须把精确工作台来源映射到其唯一允许登录的角色；JSON 需在部署平台中作为单个环境变量保存。
WORKSPACE_ORIGIN_ROLES=
# 仅在 API 不直接暴露且位于受控反向代理之后时配置；当前 Docker 演示为
# 工作台 Nginx -> 内部 API 网关 -> API，因此使用 2。生产应按实际受控代理层数设置，不能盲目沿用。
TRUST_PROXY_HOPS=2
# 仅本地/测试演示使用；预发、生产及任何共享环境始终禁止该入口。
ENABLE_DEMO_CUSTOMER_AUTH=true
# 顾客端使用 wx.login 后由 API 换取会话。生产须在微信开放平台/小程序后台登记 API 域名，并由密钥管理服务注入；不要提交到仓库。
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
# PostgreSQL 加密备份：生产仅由独立计划任务配置，绝不复用数据字段加密或审计密钥。
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=
PG_BACKUP_OUTPUT_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RPO_HOURS=24
BACKUP_MAX_RTO_MINUTES=120
